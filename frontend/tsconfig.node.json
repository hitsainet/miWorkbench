{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    // `vite.config.ts` runs in Node (`path`, `fs`, `import.meta.dirname`): its types are `@types/node`, a
    // devDependency since 2026-11-26. Without that package the file had six errors that only `tsc -b` ever showed
    // (042 acceptance 2026-11-26, F-3); CI type-checks in build mode so it reaches this project. Named here so the
    // project does not rely on another package's types pulling Node's in.
    "types": ["node"],
    // A referenced project must emit (TS6310), so it emits declarations only, and both they and the build-info
    // file go to node_modules: `tsc -b` leaves the tree as it found it.
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.tmp/tsconfig.node",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": ["vite.config.ts"]
}
